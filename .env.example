# =============================================================================
# Scholar's Home — Environment Configuration Template
# Copy this file to .env and configure your local settings
# =============================================================================

# PostgreSQL 15 Credentials (Default values match docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=scholarshome_db
DB_USER=postgres
DB_PASSWORD=postgres

# Alternative single connection string (if using managed cloud Postgres)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scholarshome_db

# Google Gemini API Configuration
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Server Configuration
PORT=5000
FLASK_ENV=production
